# Copy to .env and adjust. All defaults work fully OFFLINE (no API key needed):
# the router falls back to the deterministic offline LLM backend.

# LLM backend: "offline" (deterministic, no network) | "openai" (any OpenAI-compatible API)
LLM_PROVIDER=offline

# Only required when LLM_PROVIDER=openai
LLM_API_KEY=replace_me
LLM_BASE_URL=                      # optional; e.g. http://localhost:11434/v1 for Ollama

# Pin the exact model string used in any reported numbers
LLM_MODEL_ID=offline-heuristic-v1

# Pinned reference date used to resolve relative dates ("tomorrow", "next Tuesday").
# Pinned so evaluation numbers are reproducible; change it only deliberately.
EVAL_TODAY=2026-10-03

# Backoff before the single system-level timeout retry (no LLM tokens spent)
TIMEOUT_BACKOFF_S=0.1
